{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DoIT",
  "version": "0.1.0",
  "identifier": "com.doit.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "DoIT",
        "label": "main",
        "width": 1440,
        "height": 900,
        "minWidth": 900,
        "minHeight": 620,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "resizable": true
      },
      {
        "title": "DoIT Companion",
        "label": "tray",
        "url": "index.html?window=tray",
        "width": 160,
        "height": 64,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "resizable": false,
        "visible": false,
        "skipTaskbar": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "dialog": false,
      "endpoints": [
        "https://raw.githubusercontent.com/yasin-islam/DoIT/main/update.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDlGMzEwRkNDMUMwQzJEOEQKUldTQ2NrczVHTFFWdGtrSld5V1ZxbVcxWG9YQkJqVjJtNEZkclVubWRrU21xOGlYMW9HQ251dW0K"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": ["../WebView2Loader.dll"],
    "windows": {
      "nsis": {
        "installerHooks": "hooks.nsh"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
