{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DoIT",
  "version": "1.1.5",
  "identifier": "com.doit.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "DoIT",
        "label": "main",
        "width": 1440,
        "height": 900,
        "minWidth": 900,
        "minHeight": 620,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "resizable": true,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --js-flags=--expose-gc --disable-background-networking --disk-cache-size=8388608 --in-process-gpu"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$HOME/**", "$DOCUMENT/**", "$DESKTOP/**", "$DOWNLOAD/**", "$PICTURE/**", "$APPDATA/**"]
      }
    }
  },
  "plugins": {
    "updater": {
      "windows": { "installMode": "passive" },
      "endpoints": [
        "https://github.com/Yasliu/DoIT/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IENENjFFM0M5RjE4RkQyQTMKUldTajBvL3h5ZU5oelZzZUE1N01ZUlJLM3BGWmVmbkJXbXdZMVJKNzREZXhLNStuVm1kOFlsbmIK"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "fileAssociations": [
      {
        "ext": ["md"],
        "name": "Markdown Document",
        "description": "Markdown document",
        "mimeType": "text/markdown",
        "role": "Editor"
      },
      {
        "ext": ["txt"],
        "name": "Text Document",
        "description": "Plain text document",
        "mimeType": "text/plain",
        "role": "Editor"
      }
    ],
    "resources": [],
    "windows": {
      "nsis": {
        "installerHooks": "hooks.nsh"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
